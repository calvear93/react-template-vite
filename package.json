{
	"$schema": "https://json.schemastore.org/package.json",
	"version": "0.0.1",
	"project": "(((project-name)))",
	"name": "(((app-name)))",
	"title": "(((app-title)))",
	"description": "(((app-description)))",
	"scripts": {
		"start:dev": "env -e dev -m debug --log debug : vite",
		"start:release": "env -e release -m debug : vite",
		"build:dev": "env -e dev -m build --log debug : vite build",
		"build:release": "env -e release -m build --log debug : vite build",
		"test:dev": "env -e dev -m test : vitest",
		"test:release": "env -e release -m test : vitest",
		"test:mutation": "env -e dev -m test : stryker run",
		"env:schema": "env schema -e dev -m build",
		"lint": "eslint --cache --cache-location node_modules/.cache/eslint/",
		"stylelint": "stylelint --cache src/**/*.css --cache-location node_modules/.cache/stylelint/",
		"format": "prettier --cache --write **/*.{ts,cts,mts,tsx,css,json,html,md,yml,yaml,webmanifest}",
		"clean": "pnpx del-cli dist reports **/*.tsbuildinfo .node_modules",
		"preview": "pnpm build:dev && env -e dev -m build : vite preview",
		"gen:icons": "node scripts/generate-icons.mjs"
	},
	"imports": {
		"#libs/ioc": "./src/libs/ioc/ioc.builder.tsx",
		"#libs/router": "./src/libs/router/index.ts",
		"#libs/feature": "./src/libs/feature/index.ts"
	},
	"dependencies": {
		"jotai": "2.20.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router": "8.3.1",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@calvear/env": "3.4.1",
		"@iconify-json/mdi": "1.2.3",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/typescript-checker": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/eslint": "9.6.1",
		"@types/node": "26.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@unocss/eslint-config": "66.10.0",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-v8": "5.0.0",
		"@vitest/eslint-plugin": "1.6.27",
		"eslint": "10.10.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jest-dom": "5.10.1",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-perfectionist": "5.11.0",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-promise": "7.3.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-regexp": "3.3.0",
		"eslint-plugin-sonarjs": "4.2.0",
		"eslint-plugin-testing-library": "7.16.2",
		"eslint-plugin-unicorn": "74.0.0",
		"globals": "17.12.0",
		"happy-dom": "20.14.0",
		"postcss": "8.5.28",
		"prettier": "3.9.6",
		"sharp": "0.35.4",
		"stylelint": "17.15.0",
		"stylelint-config-rational-order": "0.1.2",
		"stylelint-config-recommended": "18.0.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-order": "8.1.1",
		"stylelint-prettier": "5.0.3",
		"stylelint-use-nesting": "6.0.2",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.69.0",
		"unocss": "66.10.0",
		"vite": "8.2.2",
		"vite-plugin-pwa": "1.3.0",
		"vite-plugin-webfont-dl": "3.13.1",
		"vitest": "5.0.0",
		"vitest-mock-extended": "5.1.1"
	},
	"type": "module",
	"engines": {
		"node": ">=24",
		"pnpm": ">=12"
	},
	"license": "MIT",
	"repository": "https://github.com/calvear93/react-template-vite",
	"keywords": [
		"react",
		"pnpm",
		"vite",
		"vitest",
		"typescript",
		"spa",
		"pwa",
		"unocss"
	]
}
